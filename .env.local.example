# ========================================
# Attendify Frontend - Environment Variables
# ========================================
# 
# SETUP INSTRUCTIONS:
# 1. Copy this file: cp .env.local.example .env.local
# 2. Update the values below with your backend API URL
# 3. Never commit .env.local to version control
# 
# ========================================

# API Configuration
NEXT_PUBLIC_AUTH_API_URL=https://attendifyauth-production.up.railway.app/api/v1/auth
NEXT_PUBLIC_USER_API_URL=https://attendifyauth-production.up.railway.app/api/v1/users
# Backend API
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8082/api/v1

# App Configuration
NEXT_PUBLIC_APP_NAME=Attendify
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment
NODE_ENV=development
